{
  "domain": "skyrc_charger",
  "name": "SkyRC Charger",
  "bluetooth": [
    {
      "local_name": "#Charger*",
      "connectable": true
    },
    {
      "local_name": "Charger*",
      "connectable": true
    },
    {
      "local_name": "HitecCharger*",
      "connectable": true
    },
    {
      "local_name": "PSU650*",
      "connectable": true
    }
  ],
  "codeowners": [
    "@srThibaultP"
  ],
  "config_flow": true,
  "dependencies": [
    "bluetooth",
    "bluetooth_adapters"
  ],
  "documentation": "https://github.com/srThibaultP/ha-skyrc-charger",
  "integration_type": "hub",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/srThibaultP/ha-skyrc-charger/issues",
  "requirements": [
    "bleak-retry-connector>=3.4.0"
  ],
  "version": "2.9.0"
}
